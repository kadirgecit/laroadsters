# Copy to .env.local for local dev (gitignored).
# Set the same vars in the Vercel project Settings → Environment Variables
# for Production (and Preview if you want admin to work on preview URLs).

# Neon Postgres pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Vercel Blob read-write token (Settings → Storage → your Blob store)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Long random string used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=replace-with-a-long-random-string

# Initial admin login (used by db/seed.ts the first time you run it).
# After the first seed, change the password in the DB or via the admin UI.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
